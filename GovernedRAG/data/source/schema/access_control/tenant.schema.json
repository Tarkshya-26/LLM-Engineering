{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.insurellm.example/source/v1/access_control/tenant.schema.json",
  "title": "Tenant",
  "description": "A hard isolation boundary. access_control/tenants.jsonl. One internal tenant plus one per customer that uses the support portal.",
  "type": "object",
  "properties": {
    "schema_version": { "$ref": "../common.schema.json#/$defs/schema_version" },
    "tenant_id": { "$ref": "../common.schema.json#/$defs/tenant_id" },
    "tenant_type": { "enum": ["internal", "customer"] },
    "name": { "type": "string", "minLength": 1 },
    "customer_id": { "anyOf": [{ "$ref": "../common.schema.json#/$defs/customer_id" }, { "type": "null" }] },
    "region": { "$ref": "../common.schema.json#/$defs/region" },
    "tenant_status": { "enum": ["active", "suspended", "offboarded"] },
    "created_at": { "$ref": "../common.schema.json#/$defs/datetime" },
    "updated_at": { "$ref": "../common.schema.json#/$defs/datetime" }
  },
  "required": ["schema_version", "tenant_id", "tenant_type", "name", "customer_id", "region", "tenant_status", "created_at", "updated_at"],
  "additionalProperties": false,
  "allOf": [{
    "if": { "properties": { "tenant_type": { "const": "internal" } }, "required": ["tenant_type"] },
    "then": { "properties": { "tenant_id": { "const": "T-INSURELLM" }, "customer_id": { "type": "null" } } },
    "else": { "properties": { "tenant_id": { "pattern": "^T-CUST-\\d{3}$" }, "customer_id": { "$ref": "../common.schema.json#/$defs/customer_id" } } }
  }],
  "examples": [{
    "schema_version": "1.0", "tenant_id": "T-CUST-012", "tenant_type": "customer", "name": "FastTrack Insurance Services portal",
    "customer_id": "CUST-012", "region": "us", "tenant_status": "active",
    "created_at": "2025-05-12T09:00:00Z", "updated_at": "2025-05-12T09:00:00Z"
  }]
}
