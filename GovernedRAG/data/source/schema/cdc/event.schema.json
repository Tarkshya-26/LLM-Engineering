{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.insurellm.example/source/v1/cdc/event.schema.json",
  "title": "CDC change event",
  "description": "One change after T0, in DELIVERY order (file order of cdc/events.jsonl). sequence is the source COMMIT order. A consumer must be idempotent (same event_id may be delivered twice) and order-aware (a lower sequence may arrive after a higher one for the same object). Deliberate anomalies are listed only in ground_truth/checkpoints.jsonl, never flagged here.",
  "type": "object",
  "properties": {
    "schema_version": {
      "$ref": "../common.schema.json#/$defs/schema_version"
    },
    "event_id": {
      "$ref": "../common.schema.json#/$defs/event_id"
    },
    "batch_id": {
      "type": "string",
      "pattern": "^BATCH-(0[1-9]|[1-9]\\d)$",
      "description": "BATCH-00 is the snapshot itself and has no events."
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "description": "Global commit order across all source systems. Unique per distinct event."
    },
    "occurred_at": {
      "$ref": "../common.schema.json#/$defs/datetime",
      "description": "When the change committed in the source system."
    },
    "emitted_at": {
      "$ref": "../common.schema.json#/$defs/datetime",
      "description": "When it was delivered. Redeliveries have a later emitted_at."
    },
    "source_system": {
      "$ref": "../common.schema.json#/$defs/source_system"
    },
    "operation": {
      "enum": [
        "insert",
        "update",
        "delete"
      ]
    },
    "object_type": {
      "enum": [
        "location",
        "department",
        "team",
        "employee",
        "compensation",
        "performance_review",
        "product",
        "product_tier",
        "customer",
        "contract",
        "contract_version",
        "project",
        "policy",
        "policy_version",
        "incident",
        "support_ticket",
        "financial_record",
        "document_version",
        "tenant",
        "principal",
        "group",
        "membership",
        "policy_set"
      ]
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "description": "Primary key of the changed object (entity id, document_version_id, principal_id, group_id, membership_id, policy_set_id, tenant_id)."
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9@_.-]+:[0-9]+$",
      "description": "object_id + ':' + sequence. Applying the same key twice must be a no-op."
    },
    "actor_principal_id": {
      "$ref": "../common.schema.json#/$defs/principal_id",
      "description": "Who made the change in the source system."
    },
    "reason": {
      "enum": [
        "new_record",
        "amendment",
        "renewal",
        "correction",
        "org_change",
        "access_change",
        "offboarding",
        "erasure_request",
        "archival",
        "price_change",
        "policy_revision",
        "status_change"
      ]
    },
    "before": {
      "description": "Row/front matter before the change. Null for insert."
    },
    "after": {
      "description": "Row/front matter after the change. Null for delete."
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "batch_id",
    "sequence",
    "occurred_at",
    "emitted_at",
    "source_system",
    "operation",
    "object_type",
    "object_id",
    "idempotency_key",
    "actor_principal_id",
    "reason",
    "before",
    "after"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "$comment": "insert: no before image, full after image",
      "if": {
        "properties": {
          "operation": {
            "const": "insert"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "before": {
            "type": "null"
          },
          "after": {
            "type": "object"
          }
        }
      }
    },
    {
      "$comment": "update: both images",
      "if": {
        "properties": {
          "operation": {
            "const": "update"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "before": {
            "type": "object"
          },
          "after": {
            "type": "object"
          }
        }
      }
    },
    {
      "$comment": "delete: before image only. For personal-data erasure the before image is reduced to ids (see README).",
      "if": {
        "properties": {
          "operation": {
            "const": "delete"
          }
        },
        "required": [
          "operation"
        ]
      },
      "then": {
        "properties": {
          "before": {
            "type": "object"
          },
          "after": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
