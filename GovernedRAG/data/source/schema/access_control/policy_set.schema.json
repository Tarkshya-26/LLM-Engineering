{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.insurellm.example/source/v1/access_control/policy_set.schema.json",
  "title": "Authorization policy set",
  "description": "Contract for access_control/policies.yaml (validated after YAML load). Policies are DATA: the deterministic engine reads them. Default deny; steps run in decision_order; a deny at any step is final. Nothing here is decided by an LLM.",
  "type": "object",
  "$defs": {
    "label": {
      "$ref": "../common.schema.json#/$defs/sensitivity_label"
    },
    "employment_type": {
      "enum": [
        "full_time",
        "part_time",
        "contractor"
      ]
    },
    "job_level": {
      "type": "string",
      "pattern": "^(IC[1-6]|M[1-4]|E[1-3])$"
    },
    "membership_rule": {
      "description": "How the generator (and later HR/IT provisioning) decides who is in a group. Evaluated per employee at every point in time, producing time-bounded memberships.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "department_members"
            },
            "department_code": {
              "type": "string",
              "pattern": "^[a-z]+(-[a-z]+)*$"
            },
            "exclude_employment_types": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/employment_type"
              }
            }
          },
          "required": [
            "kind",
            "department_code",
            "exclude_employment_types"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "job_levels"
            },
            "levels": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/job_level"
              }
            },
            "exclude_employment_types": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/employment_type"
              }
            }
          },
          "required": [
            "kind",
            "levels",
            "exclude_employment_types"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "job_titles"
            },
            "titles": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "exclude_employment_types": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/employment_type"
              }
            }
          },
          "required": [
            "kind",
            "titles",
            "exclude_employment_types"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "properties": {
    "schema_version": {
      "$ref": "../common.schema.json#/$defs/schema_version"
    },
    "policy_set_id": {
      "$ref": "../common.schema.json#/$defs/policy_set_id"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "effective_from": {
      "$ref": "../common.schema.json#/$defs/date"
    },
    "default_decision": {
      "const": "deny"
    },
    "label_order": {
      "description": "Least to most sensitive. Used for group ceilings and the 'never looser than default' rule.",
      "const": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "decision_order": {
      "description": "Steps run in this order. A deny at any step is final: no later step, grant or role can override it. There is no allow-override and no break-glass path in v1.",
      "const": [
        "global_deny",
        "tenant",
        "label",
        "grant"
      ]
    },
    "global_deny_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^GD-\\d{2}$"
          },
          "condition": {
            "enum": [
              "principal_not_active",
              "document_deleted",
              "document_tenant_not_active"
            ]
          },
          "description": {
            "$ref": "../common.schema.json#/$defs/short_text"
          }
        },
        "required": [
          "rule_id",
          "condition",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "grant_validity_rules": {
      "description": "Conditions under which a grant listed on a document does NOT count. A grant that fails one is ignored (it cannot allow); it does not deny on its own.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^GV-\\d{2}$"
          },
          "condition": {
            "enum": [
              "membership_not_valid_at_decision_time",
              "edge_not_valid_at_decision_time",
              "group_not_active",
              "document_label_above_group_max_label",
              "relation_not_allowed_for_label",
              "grant_type_not_allowed_for_label"
            ]
          },
          "description": {
            "$ref": "../common.schema.json#/$defs/short_text"
          }
        },
        "required": [
          "rule_id",
          "condition",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "tenant_rules": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "description": "One rule for every (principal_type, document_tenant) pair: 3 x 3 = 9, so no case is left implicit.",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": {
            "type": "string",
            "pattern": "^TR-\\d{2}$"
          },
          "principal_type": {
            "enum": [
              "employee",
              "customer_user",
              "service_account"
            ]
          },
          "document_tenant": {
            "enum": [
              "internal",
              "own_customer_tenant",
              "other_customer_tenant"
            ]
          },
          "access": {
            "enum": [
              "allowed",
              "public_only",
              "grant_required",
              "scope_required",
              "never"
            ],
            "description": "allowed = continue to the label step. public_only = continue only for public-label documents. grant_required = continue, and the grant step must match even if the label alone would allow. scope_required = the document's tenant must be in the principal's service_scopes. never = deny."
          },
          "description": {
            "$ref": "../common.schema.json#/$defs/short_text"
          }
        },
        "required": [
          "rule_id",
          "principal_type",
          "document_tenant",
          "access",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "label_rules": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "$ref": "#/$defs/label"
          },
          "allowed_principal_types": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 1,
            "items": {
              "enum": [
                "employee",
                "customer_user",
                "service_account"
              ]
            }
          },
          "requires_grant": {
            "type": "boolean"
          },
          "allowed_grant_types": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "group",
                "relation",
                "principal",
                "tenant_membership"
              ]
            },
            "description": "tenant_membership = the document sits in the principal's own customer tenant. It is implicit: documents do not list it."
          },
          "allowed_relations": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "../common.schema.json#/$defs/relation_rule"
            }
          },
          "description": {
            "$ref": "../common.schema.json#/$defs/short_text"
          }
        },
        "required": [
          "label",
          "allowed_principal_types",
          "requires_grant",
          "allowed_grant_types",
          "allowed_relations",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "relation_definitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "../common.schema.json#/$defs/relation_rule"
          },
          "subject_type": {
            "enum": [
              "employee",
              "customer"
            ]
          },
          "evaluation": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "principal_is_subject",
                  "edge"
                ]
              },
              "edge_relations": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z_]+$"
                },
                "description": "Relation names from relationships/edge.schema.json."
              },
              "direction": {
                "enum": [
                  "principal_to_subject",
                  "subject_to_principal",
                  null
                ]
              },
              "transitive": {
                "type": "boolean"
              },
              "max_depth": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 1,
                "maximum": 5
              },
              "evaluated_as_of": {
                "const": "decision_time",
                "description": "Edges are filtered by valid_from/valid_to at the moment of the decision."
              }
            },
            "required": [
              "kind",
              "edge_relations",
              "direction",
              "transitive",
              "max_depth",
              "evaluated_as_of"
            ],
            "additionalProperties": false
          },
          "description": {
            "$ref": "../common.schema.json#/$defs/short_text"
          }
        },
        "required": [
          "name",
          "subject_type",
          "evaluation",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "groups": {
      "description": "The complete group catalog. access_control/groups.jsonl must contain exactly these groups (validator invariant). No nested groups in v1.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "group_id": {
            "$ref": "../common.schema.json#/$defs/group_id"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "group_type": {
            "enum": [
              "department",
              "functional",
              "restricted"
            ]
          },
          "department_code": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-z]+(-[a-z]+)*$"
          },
          "max_label": {
            "$ref": "#/$defs/label"
          },
          "membership_rule": {
            "$ref": "#/$defs/membership_rule"
          },
          "description": {
            "$ref": "../common.schema.json#/$defs/short_text"
          }
        },
        "required": [
          "group_id",
          "name",
          "group_type",
          "department_code",
          "max_label",
          "membership_rule",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "service_bindings": {
      "description": "Service accounts and the groups they are bound to. Bindings are explicit lists so least privilege is reviewable.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "principal_id": {
            "type": "string",
            "pattern": "^P-SVC-\\d{3}$"
          },
          "purpose": {
            "enum": [
              "baseline_eval"
            ]
          },
          "groups": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "../common.schema.json#/$defs/group_id"
            }
          },
          "service_scopes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "../common.schema.json#/$defs/tenant_id"
            }
          },
          "description": {
            "$ref": "../common.schema.json#/$defs/short_text"
          }
        },
        "required": [
          "principal_id",
          "purpose",
          "groups",
          "service_scopes",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "document_type_defaults": {
      "type": "array",
      "minItems": 28,
      "maxItems": 28,
      "description": "The label and grants every document of a type starts with: one entry per document_type in the front matter schema. A document may be tighter (higher label, or the same label with fewer grants) but never looser (validator invariant).",
      "items": {
        "type": "object",
        "properties": {
          "document_type": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "source_system": {
            "$ref": "../common.schema.json#/$defs/source_system"
          },
          "tenant_scope": {
            "enum": [
              "internal",
              "customer"
            ]
          },
          "sensitivity_label": {
            "$ref": "#/$defs/label"
          },
          "access_groups": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "../common.schema.json#/$defs/group_id"
            }
          },
          "access_relation_templates": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "properties": {
                "relation": {
                  "$ref": "../common.schema.json#/$defs/relation_rule"
                },
                "subject_from": {
                  "enum": [
                    "primary_employee",
                    "primary_customer"
                  ]
                }
              },
              "required": [
                "relation",
                "subject_from"
              ],
              "additionalProperties": false
            }
          },
          "access_principal_templates": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "department_head",
                "project_sponsor",
                "project_lead",
                "project_members"
              ]
            },
            "description": "Named principals resolved per document from its subject entities."
          },
          "retention_class": {
            "enum": [
              "standard",
              "personal_data",
              "financial_record",
              "legal_hold"
            ]
          },
          "content_origin": {
            "enum": [
              "internal",
              "customer_submitted",
              "public_source"
            ]
          },
          "description": {
            "$ref": "../common.schema.json#/$defs/short_text"
          }
        },
        "required": [
          "document_type",
          "source_system",
          "tenant_scope",
          "sensitivity_label",
          "access_groups",
          "access_relation_templates",
          "access_principal_templates",
          "retention_class",
          "content_origin",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "lifecycle_visibility": {
      "description": "NOT an authorization rule. Which document statuses normal retrieval returns. history_only = only when the query asks for an as-of date or history. Authorization still runs on every version returned.",
      "type": "object",
      "properties": {
        "current": {
          "const": "default_visible"
        },
        "superseded": {
          "enum": [
            "history_only",
            "never"
          ]
        },
        "archived": {
          "enum": [
            "history_only",
            "never"
          ]
        },
        "deleted": {
          "const": "never"
        }
      },
      "required": [
        "current",
        "superseded",
        "archived",
        "deleted"
      ],
      "additionalProperties": false
    },
    "erasure": {
      "description": "What an erasure request removes. Documents with a listed retention_class about the subject are deleted; business records keep the person as a named party.",
      "type": "object",
      "properties": {
        "deletes_retention_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "personal_data"
            ]
          }
        },
        "retains_retention_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "standard",
              "financial_record",
              "legal_hold"
            ]
          }
        },
        "deletes_entity_types": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "compensation",
              "performance_review"
            ]
          },
          "description": "Entity rows about the subject that are deleted outright."
        },
        "nulls_entity_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+\\.[a-z_]+$"
          }
        },
        "cdc_before_image": {
          "const": "ids_only"
        }
      },
      "required": [
        "deletes_retention_classes",
        "retains_retention_classes",
        "deletes_entity_types",
        "nulls_entity_fields",
        "cdc_before_image"
      ],
      "additionalProperties": false
    },
    "audit": {
      "type": "object",
      "properties": {
        "log_allows_for_labels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/label"
          }
        },
        "log_all_denies": {
          "type": "boolean"
        },
        "retain_days": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "log_allows_for_labels",
        "log_all_denies",
        "retain_days"
      ],
      "additionalProperties": false
    },
    "historical_version_authorization": {
      "description": "How a non-current version (superseded or archived) is authorized when retrieval returns it for a history or as-of query.",
      "type": "object",
      "properties": {
        "rule": {
          "const": "must_pass_own_and_current",
          "description": "Allow only if the principal passes the version's OWN grants AND the grants of the document's CURRENT version at decision time. History never grants more than the current version does."
        },
        "when_no_current_version": {
          "const": "own_grants_only",
          "description": "If every version is archived (no current one), the latest non-deleted version stands in for 'current'."
        },
        "description": {
          "$ref": "../common.schema.json#/$defs/short_text"
        }
      },
      "required": [
        "rule",
        "when_no_current_version",
        "description"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "policy_set_id",
    "version",
    "effective_from",
    "default_decision",
    "label_order",
    "decision_order",
    "global_deny_rules",
    "grant_validity_rules",
    "tenant_rules",
    "label_rules",
    "relation_definitions",
    "groups",
    "service_bindings",
    "document_type_defaults",
    "lifecycle_visibility",
    "historical_version_authorization",
    "erasure",
    "audit"
  ],
  "additionalProperties": false,
  "$comment": "The reviewed instance is access_control/policies.yaml; tools/check_schemas.py validates it against this schema and cross-checks groups, relations, document types and label ceilings."
}
