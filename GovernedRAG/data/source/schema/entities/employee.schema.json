{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.insurellm.example/source/v1/entities/employee.schema.json",
  "title": "Employee",
  "description": "Core HR record: who someone is and where they sit. Pay lives in compensation, ratings in performance_review. entities/employees.jsonl. System of record: hris.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/record_envelope"
    },
    {
      "if": {
        "properties": {
          "employment_status": {
            "const": "terminated"
          }
        },
        "required": [
          "employment_status"
        ]
      },
      "then": {
        "properties": {
          "termination_date": {
            "$ref": "../common.schema.json#/$defs/date"
          }
        }
      },
      "else": {
        "properties": {
          "termination_date": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "work_arrangement": {
            "const": "remote"
          }
        },
        "required": [
          "work_arrangement"
        ]
      },
      "then": {
        "properties": {
          "remote_city": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "remote_city": {
            "type": "null"
          }
        }
      }
    }
  ],
  "properties": {
    "employee_id": {
      "$ref": "../common.schema.json#/$defs/employee_id"
    },
    "tenant_id": {
      "const": "T-INSURELLM"
    },
    "source_system": {
      "const": "hris"
    },
    "first_name": {
      "type": "string",
      "minLength": 1
    },
    "last_name": {
      "type": "string",
      "minLength": 1
    },
    "preferred_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "work_email": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+@insurellm\\.example$"
    },
    "date_of_birth": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/date"
        },
        {
          "type": "null"
        }
      ],
      "description": "Personal data. Null after an erasure request."
    },
    "job_title": {
      "type": "string",
      "minLength": 1
    },
    "job_level": {
      "type": "string",
      "pattern": "^(IC[1-6]|M[1-4]|E[1-3])$",
      "description": "IC = individual contributor, M = manager, E = executive."
    },
    "department_id": {
      "$ref": "../common.schema.json#/$defs/department_id"
    },
    "team_id": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/team_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "manager_id": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/employee_id"
        },
        {
          "type": "null"
        }
      ],
      "description": "Null only for the CEO."
    },
    "location_id": {
      "$ref": "../common.schema.json#/$defs/location_id"
    },
    "work_arrangement": {
      "enum": [
        "onsite",
        "hybrid",
        "remote"
      ]
    },
    "remote_city": {
      "type": [
        "string",
        "null"
      ],
      "description": "Set only when work_arrangement is remote."
    },
    "employment_type": {
      "enum": [
        "full_time",
        "part_time",
        "contractor"
      ]
    },
    "employment_status": {
      "enum": [
        "active",
        "on_leave",
        "terminated"
      ]
    },
    "hire_date": {
      "$ref": "../common.schema.json#/$defs/date"
    },
    "termination_date": {
      "$ref": "../common.schema.json#/$defs/nullable_date"
    },
    "recognitions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "award_code": {
            "type": "string",
            "pattern": "^[A-Z]{2,8}$"
          },
          "award_name": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "minimum": 2015,
            "maximum": 2030
          }
        },
        "required": [
          "award_code",
          "award_name",
          "year"
        ],
        "additionalProperties": false
      }
    },
    "hire_date_precision": {
      "$ref": "../common.schema.json#/$defs/date_precision"
    }
  },
  "required": [
    "employee_id",
    "first_name",
    "last_name",
    "preferred_name",
    "work_email",
    "date_of_birth",
    "job_title",
    "job_level",
    "department_id",
    "team_id",
    "manager_id",
    "location_id",
    "work_arrangement",
    "remote_city",
    "employment_type",
    "employment_status",
    "hire_date",
    "hire_date_precision",
    "termination_date",
    "recognitions"
  ],
  "unevaluatedProperties": false,
  "examples": [
    {
      "schema_version": "1.0",
      "tenant_id": "T-INSURELLM",
      "source_system": "hris",
      "sensitivity_label": "internal",
      "record_status": "active",
      "created_at": "2017-01-09T09:00:00Z",
      "updated_at": "2025-01-10T09:00:00Z",
      "employee_id": "EMP-021",
      "first_name": "Maxine",
      "last_name": "Thompson",
      "preferred_name": null,
      "work_email": "maxine.thompson@insurellm.example",
      "date_of_birth": "1991-01-15",
      "job_title": "Senior Data Engineer",
      "job_level": "IC4",
      "department_id": "DEPT-02",
      "team_id": "TEAM-06",
      "manager_id": "EMP-005",
      "location_id": "LOC-02",
      "work_arrangement": "onsite",
      "remote_city": null,
      "employment_type": "full_time",
      "employment_status": "active",
      "hire_date": "2017-01-01",
      "termination_date": null,
      "recognitions": [
        {
          "award_code": "IIOTY",
          "award_name": "Insurellm Innovator of the Year",
          "year": 2023
        }
      ],
      "hire_date_precision": "month",
      "origin": "kb_seed"
    }
  ]
}
