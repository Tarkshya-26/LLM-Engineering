  "$defs": {
    "document_version_image": {
      "type": "object",
      "description": "A document version as seen by CDC: its front matter plus where the body lives.",
      "properties": {
        "front_matter": {
          "$ref": "../documents/front_matter.schema.json"
        },
        "body_path": {
          "type": "string",
          "pattern": "^documents/(hris|crm|clm|erp|wiki|grc|itsm|pm|support|public_web)/DOC-[A-Z]+-\\d{4}/v[1-9]\\d*\\.md$"
        }
      },
      "required": [
        "front_matter",
        "body_path"
      ],
      "additionalProperties": false
    },
    "erased_image": {
      "type": "object",
      "description": "Before image of an erasure delete: identifiers only, so the event log itself does not retain the personal data.",
      "properties": {
        "erased": {
          "const": true
        },
        "object_id": {
          "type": "string"
        },
        "subject_employee_id": {
          "$ref": "../common.schema.json#/$defs/employee_id"
        }
      },
      "required": [
        "erased",
        "object_id"
      ],
      "additionalProperties": false
    }
  },
  "examples": [
    {
      "schema_version": "1.0",
      "event_id": "EVT-000231",
      "batch_id": "BATCH-03",
      "sequence": 231,
      "occurred_at": "2025-10-01T09:00:00Z",
      "emitted_at": "2025-10-01T09:00:04Z",
      "source_system": "hris",
      "operation": "update",
      "object_type": "membership",
      "object_id": "MEM-00117",
      "idempotency_key": "MEM-00117:231",
      "actor_principal_id": "P-EMP-050",
      "reason": "org_change",
      "before": {
        "schema_version": "1.0",
        "membership_id": "MEM-00117",
        "principal_id": "P-EMP-036",
