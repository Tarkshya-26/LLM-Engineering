{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.insurellm.example/source/v1/entities/financial_record.schema.json",
  "title": "Financial record",
  "description": "A period-level finance artifact: P&L, department budget, product revenue, receivables summary or board metrics. entities/financial_records.jsonl. System of record: erp.",
  "type": "object",
  "allOf": [
    {
      "$ref": "../common.schema.json#/$defs/record_envelope"
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "department_budget"
          }
        },
        "required": [
          "record_type"
        ]
      },
      "then": {
        "properties": {
          "department_id": {
            "$ref": "../common.schema.json#/$defs/department_id"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "product_revenue"
          }
        },
        "required": [
          "record_type"
        ]
      },
      "then": {
        "properties": {
          "product_id": {
            "$ref": "../common.schema.json#/$defs/product_id"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "record_type": {
            "const": "board_metrics"
          }
        },
        "required": [
          "record_type"
        ]
      },
      "then": {
        "properties": {
          "sensitivity_label": {
            "const": "restricted"
          }
        }
      }
    }
  ],
  "properties": {
    "financial_id": {
      "$ref": "../common.schema.json#/$defs/financial_id"
    },
    "tenant_id": {
      "const": "T-INSURELLM"
    },
    "source_system": {
      "const": "erp"
    },
    "sensitivity_label": {
      "enum": [
        "confidential",
        "restricted"
      ]
    },
    "record_type": {
      "enum": [
        "quarterly_pnl",
        "department_budget",
        "product_revenue",
        "receivables_summary",
        "board_metrics"
      ]
    },
    "period": {
      "type": "string",
      "pattern": "^(\\d{4}-Q[1-4]|FY\\d{4})$"
    },
    "department_id": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/department_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "product_id": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/product_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "line_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "$ref": "../common.schema.json#/$defs/snake_case"
          },
          "amount": {
            "type": "number"
          },
          "currency": {
            "$ref": "../common.schema.json#/$defs/currency"
          },
          "customer_id": {
            "anyOf": [
              {
                "$ref": "../common.schema.json#/$defs/customer_id"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "item",
          "amount",
          "currency",
          "customer_id"
        ],
        "additionalProperties": false
      }
    },
    "prepared_by": {
      "$ref": "../common.schema.json#/$defs/employee_id"
    },
    "approved_by": {
      "anyOf": [
        {
          "$ref": "../common.schema.json#/$defs/employee_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "is_final": {
      "type": "boolean"
    }
  },
  "required": [
    "financial_id",
    "record_type",
    "period",
    "department_id",
    "product_id",
    "line_items",
    "prepared_by",
    "approved_by",
    "is_final"
  ],
  "unevaluatedProperties": false,
  "examples": [
    {
      "schema_version": "1.0",
      "tenant_id": "T-INSURELLM",
      "source_system": "erp",
      "sensitivity_label": "confidential",
      "record_type": "product_revenue",
      "record_status": "active",
      "created_at": "2025-04-10T09:00:00Z",
      "updated_at": "2025-04-15T09:00:00Z",
      "financial_id": "FIN-019",
      "period": "2025-Q1",
      "department_id": null,
      "product_id": "PROD-007",
      "line_items": [
        {
          "item": "subscription_revenue",
          "amount": 612000,
          "currency": "USD",
          "customer_id": null
        }
      ],
      "prepared_by": "EMP-042",
      "approved_by": "EMP-040",
      "is_final": true,
      "origin": "generated"
    }
  ]
}
